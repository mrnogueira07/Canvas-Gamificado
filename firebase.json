{
    "hosting": [
        {
            "site": "mindcanvas",
            "public": "dist",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "/api/proxy-image",
                    "function": "proxyImage"
                },
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ],
            "cleanUrls": true
        },
        {
            "site": "canvasgame-2025",
            "public": "dist",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "redirects": [
                {
                    "source": "/",
                    "destination": "https://mindcanvas.web.app/login",
                    "type": 301
                },
                {
                    "source": "/login",
                    "destination": "https://mindcanvas.web.app/login",
                    "type": 301
                },
                {
                    "source": "/inicio",
                    "destination": "https://mindcanvas.web.app/login",
                    "type": 301
                }
            ],
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ],
            "cleanUrls": true
        }
    ],
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                "*.local"
            ]
        }
    ]
}
