rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção de projetos:
    // - Qualquer usuário autenticado pode LER todos os projetos (para o ranking global)
    // - Apenas o dono pode escrever/criar/excluir
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Coleção de usuários:
    // - Qualquer usuário autenticado pode LER perfis (para exibir nome/foto no ranking)
    // - Apenas o próprio usuário pode escrever no seu perfil
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Coleção de pastas: usuário só acessa suas próprias pastas
    match /folders/{folderId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
