rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Cada usuário só pode acessar seus próprios arquivos
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // PDFs exportados ficam em /exports/{userId}/
    match /exports/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Logos são legíveis publicamente (com L maiúsculo e minúsculo)
    match /Logos/{allPaths=**} {
      allow read: if true;
    }

    match /logos/{allPaths=**} {
      allow read: if true;
    }

    // Pasta de consulta da BNCC: apenas usuários logados podem ler
    match /{folderName}/{allPaths=**} {
      allow read: if (folderName == "consulta BNCC" || folderName == "consulta%20BNCC") && request.auth != null;
      allow write: if false;
    }
  }
}
